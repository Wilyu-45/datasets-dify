# ═══════════════════════════════════════════
# Docker Compose 环境变量覆盖文件（可选）
# 
# 用途：覆盖 docker-compose.yml 中默认的环境变量
# 用法：cp .env.docker.example .env && vim .env
# 
# 此文件优先级高于 docker-compose.yml 中的默认值
# ═══════════════════════════════════════════

# ──── 后端日志级别 ────
RAG_LOG_LEVEL=info

# ──── 前端端口映射（独立部署时生效）───
FRONTEND_PORT=80

# ──── Nginx 端口映射（如有 nginx 服务）───
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ──── PostgreSQL 数据库配置 ────
PG_DBNAME=ragsystem_production
PG_USER=ragsystem_app
PG_PASSWORD=ragsystem_secure_password_2026
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAINTENANCE_WORK_MEM=128MB

# ──── 前后端分离部署（生产方定制前端时设置）───
# VITE_API_BASE_URL=/api          # 同源部署（Nginx 反代到 /api/）
VITE_API_BASE_URL=https://api.rag.example.com/api  # 直连后端域名

# ──── Docker 构建元信息（自动填充）───
# BUILD_DATE=2026-09-18T12:00:00Z
# VCS_REF=abc1234
