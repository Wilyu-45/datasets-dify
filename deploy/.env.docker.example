# ═══════════════════════════════════════════
# Docker Compose 环境变量覆盖文件（可选）
# 
# 用途：覆盖 docker-compose.yml 中默认的环境变量
# 用法：cp .env.docker.example .env && vim .env
# 
# 此文件优先级高于 docker-compose.yml 中的默认值
# ═══════════════════════════════════════════

# ──── 后端日志级别 ────
RAG_LOG_LEVEL=info

# ──── 前端端口映射（独立部署时生效）───
FRONTEND_PORT=80

# ──── Nginx 端口映射（如有 nginx 服务）───
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ──── 数据库选择（compose 变量 DB_TYPE → 容器 RAG_DB_TYPE）───
# mysql（默认，生产）/ postgres（--profile postgres 兼容模式）
DB_TYPE=mysql

# ──── MySQL 数据库配置（生产默认）───
MYSQL_PORT=3306
MYSQL_DBNAME=ragsystem_production
MYSQL_USER=ragsystem_app
MYSQL_PASSWORD=ragsystem_secure_password_2026
MYSQL_ROOT_PASSWORD=ragsystem_root_password_change_me
MYSQL_MAX_CONNECTIONS=200
MYSQL_INNODB_BUFFER_POOL_SIZE=512M

# ─ 全局管理接口访问控制（REQUIRE_ADMIN_FOR_GLOBAL → 容器 RAG_REQUIRE_ADMIN_FOR_GLOBAL）
# false（默认）：清理/扫描/解析/切分/流水线/网站抓取/配置写等全局接口匿名可调（存量行为）。
# true：上述接口必须带 X-Admin-Key（= backend/.env 的 RAG_ADMIN_API_KEY），否则 401；
#   前端不持有密钥，需由 Nginx 反代注入 proxy_set_header X-Admin-Key，并把
#   服务限制在内网/白名单内（详见 README.md「全局接口访问控制」）。
REQUIRE_ADMIN_FOR_GLOBAL=false

# ─ 镜像构建：Playwright Chromium 下载源（后端镜像装浏览器供抓取降级用）
# 国内网络建议：https://cdn.npmmirror.com/binaries/playwright
# PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright

# ──── MinerU provider（compose 变量 MINERU_PROVIDER → 容器 RAG_MINERU_PROVIDER）───
# mineru_net（默认，官方网页端 API；token 在 backend/.env 配 RAG_MINERU_NET_TOKEN）
# local（本地部署；需把 backend/.env 的 RAG_MINERU_API_URL 指向 host.docker.internal:7860）
MINERU_PROVIDER=mineru_net

# ──── PostgreSQL 配置（仅 --profile postgres 兼容模式使用，已注释）───
# PG_DBNAME=ragsystem_production
# PG_USER=ragsystem_app
# PG_PASSWORD=ragsystem_secure_password_2026
# PG_MAX_CONNECTIONS=100
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=1GB
# PG_MAINTENANCE_WORK_MEM=128MB

# ──── 前后端分离部署（生产方定制前端时设置）───
# VITE_API_BASE_URL=/api          # 同源部署（Nginx 反代到 /api/）
VITE_API_BASE_URL=https://api.rag.example.com/api  # 直连后端域名

# ──── Docker 构建元信息（自动填充）───
# BUILD_DATE=2026-09-18T12:00:00Z
# VCS_REF=abc1234
