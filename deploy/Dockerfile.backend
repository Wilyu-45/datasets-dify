# ═══════════════════════════════════════════
# 后端多阶段构建（Dockerfile.backend）
# 
# 阶段 1: builder - 安装 Python 依赖
# 阶段 2: runtime - 精简运行时镜像
# 
# 构建命令：
#   docker build -f deploy/Dockerfile.backend -t ragsystem-backend:latest .
# ═══════════════════════════════════════════

# ── 阶段 1: Builder ──
FROM python:3.10-slim AS builder

WORKDIR /build

# 安装构建依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY backend/requirements.txt .

# 安装 Python 包（缓存层优化）
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ── 阶段 2: Runtime ──
FROM python:3.10-slim AS runtime

# 安装运行时系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /opt/ragsystem/backend

# 从 builder 复制安装的包
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 复制应用代码
COPY backend/app ./app
COPY backend/__pycache__ __pycache__/  # 可选：预编译字节码

# 创建数据目录
RUN mkdir -p /opt/ragsystem/data/{chunks,parsed,logs,input,error}

# 非 root 用户运行（安全加固）
RUN useradd --create-home ragsystemuser
USER ragsystemuser

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# 启动命令
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]
