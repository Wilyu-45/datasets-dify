# ═══════════════════════════════════════════
# 前端多阶段构建（Dockerfile.frontend）
# 
# 阶段 1: builder - 安装依赖并构建 React/TypeScript
# 阶段 2: nginx - 静态文件托管
# 
# 构建命令：
#   docker build -f deploy/Dockerfile.frontend -t ragsystem-frontend:latest .
# ═══════════════════════════════════════════

# ── 阶段 1: Builder ──
FROM node:20-alpine AS builder

WORKDIR /build

# 复制 package.json 和 package-lock.json（缓存优化）
COPY frontend/package*.json ./

# 安装依赖（生产模式，不安装 devDependencies）
RUN npm ci --production --no-optional

# 复制源码
COPY frontend/src ./src
COPY frontend/public ./public
COPY frontend/index.html ./index.html
COPY frontend/vite.config.ts ./vite.config.ts
COPY frontend/tsconfig.json ./tsconfig.json

# 设置环境变量（可选，支持自定义 API 地址）
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# 构建生产包
RUN npm run build

# ── 阶段 2: Nginx ──
FROM nginx:alpine AS runtime

# 复制构建产物
COPY --from=builder /build/dist /usr/share/nginx/html

# 复制 Nginx 配置（可选，自定义配置放在 deploy/nginx-frontend.conf）
# COPY deploy/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

# 暴露端口
EXPOSE 80

# 启动 Nginx
CMD ["nginx", "-g", "daemon off;"]
