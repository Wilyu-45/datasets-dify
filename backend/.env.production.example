# ═══════════════════════════════════════════
# 生产配置模板（复制为 backend/.env 后使用）
# 
# ★★ 重要：后端代码（app/config.py）硬编码只读取 backend/.env 这一个文件，
#    且 dotenv 优先级高于进程环境变量。其它文件名（如 .env.production）不会被读取。
# 用法：cp .env.production.example .env && vim .env
# 
# ★ 生产安全警告：
#   - .env 严禁提交到 Git（已在 .gitignore 中）
#   - 敏感信息（AccessKey、API Key）必须使用强密码
#   - 建议通过密钥管理工具（如 HashiCorp Vault、AWS Secrets Manager）注入
# ═══════════════════════════════════════════

# ── 数据目录（生产环境建议使用独立磁盘挂载）──
RAG_DATA_ROOT=/opt/ragsystem/data

# ── 日志策略（生产环境 INFO 级别，保留 90 天）──
RAG_LOG_LEVEL=INFO
RAG_LOG_RETENTION_DAYS=90

# ── CORS 跨域配置（按需填入前端域名）──
# 模式一：独立部署（后端同时服务前端 dist/ + API）
#   RAG_CORS_ORIGINS=["https://rag.example.com"]
# 模式二：前后端分离部署（Nginx 分别代理）
#   前端域名: https://frontend.rag.example.com
#   后端域名: https://api.rag.example.com
#   RAG_CORS_ORIGINS=["https://frontend.rag.example.com"]
# ⚠️ 不要使用 ["*"]，会允许任意域名跨域访问
RAG_CORS_ORIGINS=["https://frontend.rag.example.com","https://rag.example.com"]

# ── ★ 前后端分离部署开关 ──
# 生产方定制前端时，设为 false（Nginx 分别代理前端页面和后端 API）
# 独立部署时保持 true（默认值，后端自动挂载 frontend/dist/）
RAG_SERVE_FRONTEND=false

# ═══════════════════════════════════════════
# 以下为核心业务配置，从开发环境迁移过来即可
# ═══════════════════════════════════════════

# ── Dify 配置（需替换为生产环境的 Dify 实例地址）──
RAG_DIFY_API_URL=https://dify.your-company.com/v1
RAG_DIFY_API_KEY=dataset-your-dataset-api-key-here
RAG_DIFY_APP_API_KEY=app-your-app-api-key-here
RAG_DIFY_DATASET_ID=your-dataset-uuid-here
RAG_DIFY_INDEXING_TECHNIQUE=high_quality
RAG_DIFY_DOC_FORM=text_model
RAG_DIFY_TIMEOUT=60
RAG_DIFY_INDEXING_WAIT_TIMEOUT=300
RAG_DIFY_INDEXING_POLL_INTERVAL=5.0
RAG_DIFY_SEGMENTS_PER_REQUEST=30
RAG_DIFY_MAX_SEGMENT_CHARS=5000
RAG_DIFY_MAX_RETRIES=5
RAG_DIFY_RETRY_BACKOFF=3.0

# ── 公网图片托管（OSS 阿里云，生产环境必填）──
RAG_PUBLIC_BASE_URL=https://cdn.your-company.com
RAG_IMAGE_HOST_BACKEND=oss
RAG_OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
RAG_OSS_BUCKET=your-production-bucket
RAG_OSS_ACCESS_KEY_ID=LTAI5tXXXXXXXXXXXXXXX
RAG_OSS_ACCESS_KEY_SECRET=your-oss-secret-key-here
RAG_OSS_OBJECT_PREFIX=ragsystem/output
RAG_OSS_PUBLIC_DOMAIN=https://cdn.your-company.com
RAG_DIFY_SKIP_FILE_UPLOAD=true

# ── MinerU 配置（指向生产环境的 MinerU 服务）──
RAG_MINERU_API_URL=http://127.0.0.1:7860
RAG_MINERU_RESPONSE_FORMAT_ZIP=true
RAG_MINERU_BACKEND=hybrid-engine
RAG_MINERU_BACKEND_EFFORT=high
RAG_MINERU_ENFORCE_HIGH_QUALITY=true
RAG_MINERU_LANG_LIST=["ch"]
RAG_MINERU_FORMULA_ENABLE=true
RAG_MINERU_TABLE_ENABLE=true
RAG_MINERU_RETURN_MD=true
RAG_MINERU_RETURN_MIDDLE_JSON=true
RAG_MINERU_RETURN_MODEL_OUTPUT=true
RAG_MINERU_RETURN_CONTENT_LIST=true
RAG_MINERU_RETURN_IMAGES=true
RAG_MINERU_API_TIMEOUT=3600
RAG_MINERU_MAX_RETRIES=3
RAG_MINERU_RETRY_INITIAL_WAIT=30.0
RAG_MINERU_RETRY_BACKOFF_FACTOR=2.0
RAG_MINERU_RETRY_MAX_WAIT=300.0
RAG_MINERU_LONG_DOC_PAGES_THRESHOLD=15
RAG_MINERU_LONG_DOC_BACKEND=vlm-engine
RAG_MINERU_LONG_DOC_EFFORT=high
RAG_MINERU_REJECT_LEGACY_DOC=true

# ── 自定义切分策略 ──
RAG_CHUNK_TARGET_CHARS=1500
RAG_CHUNK_SPLIT_TARGET=1200
RAG_CHUNK_OVERLAP=100
RAG_CHUNK_HARD_LIMIT=1800
RAG_CHUNK_APPENDIX_THRESHOLD=1500
RAG_CHUNK_MAX_IMAGES_PER_SEGMENT=10
RAG_CHUNK_TABLE_ROW_THRESHOLD=20
RAG_CHUNK_TABLE_MAX_CHARS=5000
RAG_CHUNK_STRATEGY=structure
RAG_CHUNK_REF_PATTERN=^\s*[\[【\(（]\s*\d+[\]】\)）]
RAG_CHUNK_FIXED_SIZE_CHARS=800
RAG_CHUNK_FIXED_OVERLAP_CHARS=100
RAG_CHUNK_SEMANTIC_THRESHOLD=0.78
RAG_LLM_ENABLED=false

# ── PostgreSQL 数据库（生产环境建议使用独立数据库服务器）──
RAG_PG_HOST=127.0.0.1
RAG_PG_PORT=5432
RAG_PG_DBNAME=ragsystem_production
RAG_PG_USER=ragsystem_app
RAG_PG_PASSWORD=your-strong-database-password-here
RAG_PG_POOL_MIN=2
RAG_PG_POOL_MAX=20
RAG_PG_POOL_TIMEOUT=60.0

# ═══════════════════════════════════════════
# 部署后检查清单：
#   □ .env.production 文件权限设置为 600（仅 root 可读）
#   □ PostgreSQL 用户 ragsystem_app 仅授予目标数据库权限（不建议用 postgres 超级用户）
#   □ OSS AccessKey 使用 RAM 子账号，仅授 PutObject/GetObject 权限
#   □ Dify API Key 从 Dify 控制台获取，确认 dataset ID 有效
#   □ Nginx 配置文件 /etc/nginx/sites-enabled/ragsystem.conf 已更新
#   □ SSL 证书已安装（使用 Let's Encrypt 或自有证书）
#   □ 防火墙仅开放 80/443 端口（禁止直接暴露 8000/5432）
# ═══════════════════════════════════════════
