# RAG 系统环境变量示例。复制为 backend/.env 后按需修改。
# 所有变量以前缀 RAG_ 加载到 Settings。

# 数据根目录（绝对路径或相对于仓库根的相对路径）
RAG_DATA_ROOT=./data

# 扫描行为
# RAG_SCAN_CHUNK_SIZE=65536

# 允许的文件扩展名（JSON 数组字符串）
# RAG_ALLOWED_EXTENSIONS=[".pdf", ".doc", ".docx", ".png", ".jpg", ".jpeg", ".tiff"]

# 日志
# RAG_LOG_LEVEL=INFO
# RAG_LOG_RETENTION_DAYS=30

# ============ MinerU API（plan.md §3.2）============
# MinerU 自带 FastAPI 服务地址（mineru-api 3.x 部署的监听地址）。
# 客户端会调用 POST {RAG_MINERU_API_URL}/file_parse
# 注意：这是 multipart/form-data 上传，不是 JSON body！
RAG_MINERU_API_URL=http://192.168.31.165:7860
# 是否以 ZIP 形式返回所有产物（推荐 true：拿到 .md/.json/图片/layout 等所有文件）
RAG_MINERU_RESPONSE_FORMAT_ZIP=true
# 解析后端选择（★ 强制使用高质量模型，对扫描件效果更好）：
#   推荐：
#     - vlm-engine         : 极致精度（VLM 大模型，CPU/GPU 都能跑）
#     - hybrid-engine      : 高精度（VLM + 文本提取），兼顾速度与效果 ★默认
#     - vlm-http-client    : vlm-engine + 远程推理
#     - hybrid-http-client : hybrid-engine + 远程推理
#   不推荐（对扫描件 / 复杂版面效果差，仅纯 CPU 冒烟使用）：
#     - pipeline / pipeline-http-client : 纯 OCR 流水线
#   即使这里误填 pipeline，客户端也会自动 WARNING 并升级到 hybrid-engine
#   （除非显式设置 RAG_MINERU_ENFORCE_HIGH_QUALITY=false）。
RAG_MINERU_BACKEND=hybrid-engine
# hybrid-engine 的解析强度（仅 hybrid-engine 生效；vlm-engine / pipeline 会忽略此参数）
#   - high  : 极致精度 + image analysis（推荐，效果最好）★默认
#   - medium: 速度快 ~80% 提升，但不支持 image analysis
#   - low   : 最快（一般不推荐）
RAG_MINERU_BACKEND_EFFORT=high
# 是否强制高质量后端（默认 true）。开启后：
#   - pipeline / pipeline-http-client 会被自动升级到 hybrid-engine
#   - 未知后端打印 WARNING 但原样发送（让 MinerU 自己报错，避免静默切换）
# 测试 pipeline 时可临时改为 false 走原行为
RAG_MINERU_ENFORCE_HIGH_QUALITY=true
# 语言列表（JSON 数组字符串，pipeline 后端使用以提升 OCR 准确率）
RAG_MINERU_LANG_LIST=["ch"]
# 是否启用公式 / 表格解析
RAG_MINERU_FORMULA_ENABLE=true
RAG_MINERU_TABLE_ENABLE=true
# ★ 输出产物开关：全部默认 true，让 MinerU 把所有产物都放进 ZIP。
#   任一为 false 时 MinerU 不会在响应中包含对应产物
#   （例如 return_images=false 就拿不到图片；return_middle_json=false 就拿不到页面/块级结构）。
#   我们的目标是"一个文档一文件夹，所有产物齐全"，所以建议全开。
RAG_MINERU_RETURN_MD=true
RAG_MINERU_RETURN_MIDDLE_JSON=true
RAG_MINERU_RETURN_MODEL_OUTPUT=true
RAG_MINERU_RETURN_CONTENT_LIST=true
RAG_MINERU_RETURN_IMAGES=true
# 单次请求超时（秒），大文件可调大
RAG_MINERU_API_TIMEOUT=1080000
# 失败重试次数
RAG_MINERU_MAX_RETRIES=3
# ---- ★ 2026-08-06 重试策略：适应 API 端自杀后自动重启的场景 ----
# MinerU 本地部署跑超 10 页文档容易 OOM 自杀，supervisor 重启服务需 30~90s。
# 旧公式 wait = backoff^(attempt-1)（1s/2s/4s）太频繁，根本接不上。
# 新公式 wait = min(initial * factor^(attempt-1), max_wait)：
#   默认 30s / 2.0x / 300s → 30s, 60s, 120s（最多 3 次）
#   覆盖服务重启耗时 + 单次重试不超过 5 分钟
RAG_MINERU_RETRY_INITIAL_WAIT=15.0
RAG_MINERU_RETRY_BACKOFF_FACTOR=2.0
RAG_MINERU_RETRY_MAX_WAIT=180.0
# 旧 RAG_MINERU_RETRY_BACKOFF 字段仍生效（作为 retry_backoff_factor 兑底），
# 保留是为了 .env 里已有该项的部署不报错。新代码不再读该字段。
RAG_MINERU_RETRY_BACKOFF=2.0
# ---- ★ 2026-08-06 长文档路由：超长页数自动切换为精准解析 API ----
# 本地部署遇到超长页数文档时，hybrid-engine 的文本路径容易用复杂 CMap / 编码
# 遇 OOM。检测到 PDF 页数 ≥ 阈值时自动切到 vlm-engine（走纯视觉路径、避免
# 解析逻辑崩服务），仅本次调用切换，不改 self.backend（不影响后续短文档）。
#   - threshold=0 禁用路由
#   - 仅对 .pdf 生效（DOCX/PPTX/XLSX 页数估算不准，不切）
#   - 需后端部署同时提供 hybrid-engine 和 vlm-engine 两套服务
RAG_MINERU_LONG_DOC_PAGES_THRESHOLD=15
RAG_MINERU_LONG_DOC_BACKEND=vlm-engine
RAG_MINERU_LONG_DOC_EFFORT=high
# 客户端预检测 .doc 旧 OLE 格式：开启后 MinerU 调用前会读文件 magic bytes 提前拒绝，
# 给用户更清晰的错误（避免让 MinerU 返 400）。MinerU 不支持 .doc，仅支持 .docx。
RAG_MINERU_REJECT_LEGACY_DOC=true
# 可选：若 MinerU 启用了鉴权，填入 Bearer token
# RAG_MINERU_API_TOKEN=

# ============ 自定义切分（plan.md §3.3）============
# 单 chunk 目标字符数（贪心合并阈值）；超出此值则继续往里塞标题
#   降低 → chunk 数量增多，召回粒度更细；提高 → 召回粒度变粗
RAG_CHUNK_TARGET_CHARS=1500
# 句号切分阈值：单 chunk 超过此值时按 "。" 切分（带 overlap）
RAG_CHUNK_SPLIT_TARGET=1200
# 句号切分时上下 chunk 的 overlap 字符数（保证语义不丢失）
RAG_CHUNK_OVERLAP=100
# 标题 slug 最大长度（避免 Windows 文件名超长）
# RAG_CHUNK_SLUG_MAX=60

# ============ PostgreSQL（manifest / doc_metadata 持久化）============
# manifest 与 doc_metadata 已从 Excel 迁移到 PostgreSQL，需配置以下连接信息。
# 应用启动时会自动幂等建表（manifest / doc_metadata），无需手工建库建表。
RAG_PG_HOST=127.0.0.1
RAG_PG_PORT=5432
RAG_PG_DBNAME=ragsystem
RAG_PG_USER=postgres
RAG_PG_PASSWORD=postgres
# 连接池大小（可选）
# RAG_PG_POOL_MIN=1
# RAG_PG_POOL_MAX=10
