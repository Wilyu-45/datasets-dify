# RAG 系统环境变量示例。复制为 backend/.env 后按需修改。
# 所有需要配置的变量都集中在这个文件（backend/.env），代码从 pydantic-settings
# 统一读取（前缀 RAG_），不再有任何散落的硬编码配置。

# 数据根目录（绝对路径或相对于仓库根的相对路径）
RAG_DATA_ROOT=./data

# 扫描行为
# RAG_SCAN_CHUNK_SIZE=65536

# 允许的文件扩展名（JSON 数组字符串）
# RAG_ALLOWED_EXTENSIONS=[".pdf", ".doc", ".docx", ".png", ".jpg", ".jpeg", ".tiff"]

# 日志
# RAG_LOG_LEVEL=INFO
# RAG_LOG_RETENTION_DAYS=30

# ---- Web 服务 / CORS ----
# 允许的跨域来源（JSON 字符串数组），用于前端 Vite(5173)/自托管(8000) 跨域访问。
# 多个来源用英文逗号分隔的 JSON 数组：
#   RAG_CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
RAG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# ============ Dify 入库（plan.md §3.4）============
# 自托管 Dify 服务地址（注意：用 HTTPS，HTTP 会 301 重定向）
RAG_DIFY_API_URL=https://dify.example.com/v1

# Dataset/Knowledge API Key（dataset- 前缀，用于 /datasets/... 知识库写操作：create_by_text / add_segments 等）
RAG_DIFY_API_KEY=dataset-xxxxxxxxxxxxxxxx

# App API Key（app- 前缀，用于 /files/upload 端点上传图片）
#   Knowledge API Key 没有 /files/upload 权限（会 401），必须用 App API Key。
#   留空则降级到 RAG_PUBLIC_BASE_URL 公网 URL 策略。
RAG_DIFY_APP_API_KEY=app-xxxxxxxxxxxxxxxx

# 目标知识库 ID（可在前端「Dify 设置」页面下拉选择，选择后自动写回此文件）
RAG_DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 索引技术（high_quality=embedding 检索；economy=关键词）
RAG_DIFY_INDEXING_TECHNIQUE=high_quality

# 文档形态（text_model=按段落切，hierarchical_model=父子分段，qa_model=问答对）
RAG_DIFY_DOC_FORM=text_model

# HTTP 超时 / 等待 indexing / 轮询间隔（秒）
RAG_DIFY_TIMEOUT=60
RAG_DIFY_INDEXING_WAIT_TIMEOUT=120
RAG_DIFY_INDEXING_POLL_INTERVAL=2.0
RAG_DIFY_SEGMENTS_PER_REQUEST=30
# 单段写入的字符上限（Dify 分段上限默认 5000，代码会按此做保护性截断）
RAG_DIFY_MAX_SEGMENT_CHARS=5000
RAG_DIFY_MAX_RETRIES=3
RAG_DIFY_RETRY_BACKOFF=2.0

# ============ 公网图片托管（§3.4 内联 URL 策略）============
# 把 chunk 中的 `![](images/xxx.jpg)` 替换为公网可访问的 URL，让 Dify 索引时拉图并内嵌。
RAG_PUBLIC_BASE_URL=

# 图片托管后端选择（oss=阿里云 OSS 永久外链；tunnel=本地隧道，已废弃）
RAG_IMAGE_HOST_BACKEND=oss

# ---- 阿里云 OSS 后端 ----
RAG_OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
RAG_OSS_BUCKET=your-bucket
# AccessKey（RAM 子账号，建议只授 PutObject/GetObject 权限）
RAG_OSS_ACCESS_KEY_ID=your-access-key-id
RAG_OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 对象 key 前缀
RAG_OSS_OBJECT_PREFIX=static/output
# 自定义 CDN 域名：留空则用 endpoint+bucket 拼
RAG_OSS_PUBLIC_DOMAIN=

# True = 完全跳过 Dify /files/upload，content 里只写 OSS 永久 URL（推荐）
RAG_DIFY_SKIP_FILE_UPLOAD=true

# ============ MinerU API（plan.md §3.2）============
# MinerU 自带 FastAPI 服务地址（mineru-api 3.x 部署的监听地址）。
# 客户端会调用 POST {RAG_MINERU_API_URL}/file_parse
RAG_MINERU_API_URL=http://192.168.31.165:7860
# 是否以 ZIP 形式返回所有产物（推荐 true）
RAG_MINERU_RESPONSE_FORMAT_ZIP=true
# 解析后端选择（推荐 hybrid-engine / vlm-engine；pipeline 仅纯 CPU 冒烟使用）
RAG_MINERU_BACKEND=hybrid-engine
# hybrid-engine 的解析强度（high=极致精度；medium=快 80%；low=最快）
RAG_MINERU_BACKEND_EFFORT=high
# 是否强制高质量后端（true 时 pipeline 会被自动升级到 hybrid-engine）
RAG_MINERU_ENFORCE_HIGH_QUALITY=true
# 语言列表（JSON 数组字符串）
RAG_MINERU_LANG_LIST=["ch"]
# 是否启用公式 / 表格解析
RAG_MINERU_FORMULA_ENABLE=true
RAG_MINERU_TABLE_ENABLE=true
# ★ 输出产物开关：全部默认 true，让 MinerU 把所有产物放进 ZIP。
RAG_MINERU_RETURN_MD=true
RAG_MINERU_RETURN_MIDDLE_JSON=true
RAG_MINERU_RETURN_MODEL_OUTPUT=true
RAG_MINERU_RETURN_CONTENT_LIST=true
RAG_MINERU_RETURN_IMAGES=true
# 单次请求超时（秒），大文件可调大
RAG_MINERU_API_TIMEOUT=1080000
# 失败重试次数
RAG_MINERU_MAX_RETRIES=3
# 重试策略：wait = min(initial * factor^(attempt-1), max_wait)
RAG_MINERU_RETRY_INITIAL_WAIT=15.0
RAG_MINERU_RETRY_BACKOFF_FACTOR=2.0
RAG_MINERU_RETRY_MAX_WAIT=180.0
# 旧 RAG_MINERU_RETRY_BACKOFF 字段仍生效（作为 retry_backoff_factor 兜底）
RAG_MINERU_RETRY_BACKOFF=2.0
# 长文档路由：PDF 页数 ≥ 阈值时自动切到 vlm-engine（阈值=0 禁用）
RAG_MINERU_LONG_DOC_PAGES_THRESHOLD=15
RAG_MINERU_LONG_DOC_BACKEND=vlm-engine
RAG_MINERU_LONG_DOC_EFFORT=high
# 客户端预检测 .doc 旧 OLE 格式并提前拒绝（MinerU 仅支持 .docx）
RAG_MINERU_REJECT_LEGACY_DOC=true
# 可选：若 MinerU 启用了鉴权，填入 Bearer token
RAG_MINERU_API_TOKEN=

# ============ 自定义切分（plan.md §3.3）============
# 单 chunk 目标字符数（贪心合并阈值）
RAG_CHUNK_TARGET_CHARS=1500
# 句号切分阈值：单 chunk 超过此值时按 "。" 切分（带 overlap）
RAG_CHUNK_SPLIT_TARGET=1200
# 句号切分时上下 chunk 的 overlap 字符数
RAG_CHUNK_OVERLAP=100
# 单 chunk 绝对上限（超过即强制硬切，防超 Dify 5000 字符段上限）
RAG_CHUNK_HARD_LIMIT=1800
# 附录处理阈值：主文本小于此值时并入前文
RAG_CHUNK_APPENDIX_THRESHOLD=1500
# 单段图片数量上限（与 Dify 端 SINGLE_CHUNK_ATTACHMENT_LIMIT 对齐）
RAG_CHUNK_MAX_IMAGES_PER_SEGMENT=10
# 表格视为「大表」的最小行数（超过则做行列压缩）
RAG_CHUNK_TABLE_ROW_THRESHOLD=20
# 大表压缩后的字符上限
RAG_CHUNK_TABLE_MAX_CHARS=5000
# 切分策略：structure（结构感知·默认）/ recursive（递归）/
#           fixed（固定长度）/ sentence（句子级）/ semantic（语义）/
#           parent_child（父子）/ late_chunking（晚切分）/ llm（LLM）
# 配置中心可按策略单独配置参数；切换策略后只显示该策略相关配置项。
RAG_CHUNK_STRATEGY=structure
# 参考文献条目行识别正则（匹配以 [1] / 【1】 等开头的行 → 归入 reference 区域）
RAG_CHUNK_REF_PATTERN=^\s*[\[【\(（]\s*\d+[\]】\)）]
# ---- fixed 策略参数 ----
RAG_CHUNK_FIXED_SIZE_CHARS=800
RAG_CHUNK_FIXED_OVERLAP_CHARS=100
# ---- semantic 策略参数（需 embedding API）----
RAG_CHUNK_SEMANTIC_THRESHOLD=0.78
RAG_CHUNK_EMBEDDING_API_URL=
RAG_CHUNK_EMBEDDING_API_KEY=
# ---- parent_child 策略参数 ----
RAG_CHUNK_PARENT_SIZE_CHARS=1500
RAG_CHUNK_CHILD_SIZE_CHARS=400
# ---- llm 策略开关（需 LLM API）----
RAG_CHUNK_LLM_ENABLED=false
# ---- llm 策略：切分提示词（要求模型只输出切分后段落的 JSON 数组）----
RAG_CHUNK_LLM_CHUNK_PROMPT=你是一名文档切分专家。请把下面文档切成语义完整、主题集中的片段。要求：1) 每个片段围绕单一主题；2) 不要切断表格、公式、代码块；3) 保留原文顺序，不遗漏、不改写原文；4) 片段长度 300~800 字。只输出一个 JSON 数组，数组元素是切分后的原文段落字符串，不要输出其他内容。
# 标题 slug 最大长度（避免 Windows 文件名超长）
# RAG_CHUNK_SLUG_MAX=60

# ============ PostgreSQL（manifest / doc_metadata 持久化）============
# manifest 与 doc_metadata 已从 Excel 迁移到 PostgreSQL，需配置以下连接信息。
# 应用启动时会自动幂等建表（manifest / doc_metadata），无需手工建库建表。
RAG_PG_HOST=127.0.0.1
RAG_PG_PORT=5432
RAG_PG_DBNAME=ragsystem
RAG_PG_USER=postgres
RAG_PG_PASSWORD=postgres
# 连接池大小（可选）
RAG_PG_POOL_MIN=1
RAG_PG_POOL_MAX=10
# 从连接池获取连接的超时时间（秒）
RAG_PG_POOL_TIMEOUT=30.0
