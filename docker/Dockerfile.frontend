# ═══════════════════════════════════════════
# 前端镜像（React + Vite 构建 → Nginx 托管 + 反向代理）
#
# 构建上下文 = 仓库根目录（compose 中 context: ..）
# 手动构建：docker build -f docker/Dockerfile.frontend -t ragsystem-frontend:latest .
#
# 阶段 1 builder：npm ci + npm run build 产出 dist/
# 阶段 2 runtime：Nginx 托管静态文件，并把 /api、/static 反代到 backend 服务
#
# ★ .dockerignore 排除了 frontend/dist，故必须在镜像内重新构建。
# ★ 前端 API 基址默认同源 /api（见 src/api/client.ts），由 Nginx 反代到后端，
#   因此无需 CORS，也无需在构建期写死后端域名。
# ═══════════════════════════════════════════

# ── 阶段 1: Builder ──
FROM node:20-alpine AS builder

# ★ npm 国内镜像（可用 --build-arg 覆盖；还原官方：--build-arg NPM_REGISTRY=https://registry.npmjs.org）
ARG NPM_REGISTRY=https://registry.npmmirror.com

WORKDIR /build

# 先拷依赖清单，利用层缓存（源码变动不触发重新 npm ci）
COPY frontend/package*.json ./

# ★ 不能用 --production / npm ci --omit=dev：tsc、vite、@vitejs/plugin-react 都在
#   devDependencies，构建阶段必须安装（产物是纯静态文件，devDeps 不会进最终镜像）
RUN npm config set registry ${NPM_REGISTRY} && npm ci

# 拷贝源码与构建配置（tsconfig.node.json 是 tsc -b 的 project references 依赖）
COPY frontend/src ./src
COPY frontend/index.html ./index.html
COPY frontend/vite.config.ts ./vite.config.ts
COPY frontend/tsconfig.json ./tsconfig.json
COPY frontend/tsconfig.node.json ./tsconfig.node.json

# 可选：自定义部署子路径 / API 基址（默认同源 /api、根路径 /）
ARG VITE_API_BASE_URL=/api
ARG VITE_BASE_PATH=/
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_BASE_PATH=$VITE_BASE_PATH

RUN npm run build

# ── 阶段 2: Nginx ──
FROM nginx:alpine AS runtime

# 静态产物
COPY --from=builder /build/dist /usr/share/nginx/html

# 站点配置（含 SPA history 回退 + /api、/static 反代到 backend）
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
