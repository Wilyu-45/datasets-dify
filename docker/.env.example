# ═══════════════════════════════════════════
# docker-compose 变量模板
#
# 用法：cp docker/.env.example docker/.env  然后按需修改
#   docker compose -f docker/docker-compose.yaml up -d --build
#   （compose 会自动加载「compose 文件同目录」的 .env，即 docker/.env）
#
# ★ 本文件只负责「编排层变量」（端口、数据库账号、镜像 tag、前端构建参数）。
#   业务配置（Dify / OSS / MinerU / 切分策略等 RAG_ 变量）请写在 backend/.env，
#   由 compose 的 env_file 注入容器。两处职责不要混淆。
# ═══════════════════════════════════════════

# ──── 镜像标签 ────
TAG=latest

# ──── 端口映射（宿主机:容器）────
# 前端访问入口（浏览器打开 http://localhost:8080）
FRONTEND_PORT=8080
# 后端直连端口（/docs、/api/health 调试用；生产可用防火墙限制或注释掉该映射）
BACKEND_PORT=8000

# ──── PostgreSQL（compose 内置数据库）────
# ★ 首次启动创建库/用户；应用启动时按方言幂等建表，无需手工建表。
#   修改密码后若数据卷已初始化，需 docker compose down -v 重建卷才生效（会丢数据）。
POSTGRES_DB=ragsystem
POSTGRES_USER=ragsystem
POSTGRES_PASSWORD=ragsystem_password_change_me
# 仅在取消 compose 中 postgres 端口映射注释时用到（宿主机直连调试）
POSTGRES_PORT=5432

# ──── 后端连接池（注入容器 RAG_PG_POOL_*）────
RAG_PG_POOL_MIN=1
RAG_PG_POOL_MAX=10

# ──── 后端日志级别 ────
RAG_LOG_LEVEL=info

# ──── 前端构建参数 ────
# API 基址：默认同源 /api（由前端 Nginx 反代到 backend），一般无需修改。
# 如需前端直连独立后端域名：VITE_API_BASE_URL=https://api.your-domain.com/api
VITE_API_BASE_URL=/api
# 部署子路径（如部署到 https://host/rag/ 下则设 /rag/）
VITE_BASE_PATH=/

# ──── 构建镜像源（国内网络专用，避免 deb.debian.org 502 / pip、npm 超时）────
# 默认已走阿里云 / npmmirror，一般无需修改；如需还原官方源，改成下面注释的值。
# Debian apt 镜像（还原官方：deb.debian.org）
APT_MIRROR=mirrors.aliyun.com
# pip 源（还原官方：https://pypi.org/simple/）
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
# npm 源（还原官方：https://registry.npmjs.org）
NPM_REGISTRY=https://registry.npmmirror.com
# Playwright Chromium 二进制下载源
PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
