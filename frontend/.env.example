# 前端配置示例。复制为 frontend/.env 后按需修改。
# Vite 开发服务器把 /api 代理转发到后端地址
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# 开发服务器监听端口
VITE_DEV_PORT=5173

# ★ 前后端分离部署（生产方定制前端时常用）：
# 后端 API 基础地址，默认同源 /api（走 Nginx 反代）。
# - 独立后端域名（直连模式，需后端 CORS 放行该域）：
#   VITE_API_BASE_URL=https://api.rag.example.com/api
# - 保持默认则使用相对路径（由 Vite 代理 / Nginx 反向代理转发到 :8000）
VITE_API_BASE_URL=
# 部署子路径（如部署到 https://host/rag/ 下则设 VITE_BASE_PATH=/rag/）
VITE_BASE_PATH=/
# 生产构建 sourcemap（生产方定制前端时建议关闭避免源码泄漏）
VITE_SOURCEMAP=false
